# Copy to .env and fill in for `docker compose up`. Never commit the real .env file.

# Database (used by both containers)
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Security: at least 64 random characters; tokens stay valid across restarts
JWT_SECRET=

# Admin account created on first start
ADMIN_EMAIL=admin@petshop.az
ADMIN_PASSWORD=

# Optional: SMTP for newsletter and password-reset emails (Gmail: smtp.gmail.com + App Password)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_NOTIFY_TO=
# Optional: Brevo HTTPS email API key. Used instead of SMTP when set (Railway Free/Trial/Hobby block SMTP ports).
# MAIL_FROM must then be a sender email verified in your Brevo account.
BREVO_API_KEY=

# Optional: Google sign-in (OAuth Web client id)
GOOGLE_CLIENT_ID=
